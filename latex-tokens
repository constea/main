LATEX_STYLE_PRESET

ENGINE = pdflatex

DOCUMENT_CLASS = article
DOCUMENT_FONT_SIZE = 12pt

PAPER:
  SIZE = A4
  WIDTH = 210mm
  HEIGHT = 297mm

MARGINS:
  LEFT = 15mm
  RIGHT = 15mm
  TOP = 20mm
  BOTTOM = 15mm

RUSSIAN_SUPPORT:
  FONT_ENCODING = T2A
  INPUT_ENCODING = utf8
  LANGUAGE = russian

REQUIRED_PACKAGES:
  fontenc[T2A]
  inputenc[utf8]
  babel[russian]
  fancyhdr

PAGE_STYLE:
  PACKAGE = fancyhdr
  STYLE = fancy
  HEADER = empty
  FOOTER = empty
  RIGHT_HEADER = page_number

DOCUMENT_TITLE:
  MAKE_TITLE = false
  STYLE = \bfseries \LARGE
  RENDER = {STYLE}{TITLE}

GENERATION_RULES:
  - Use pdflatex-compatible syntax only.
  - Do not use fontspec.
  - Do not use polyglossia.
  - Do not use XeLaTeX-specific commands.
  - Do not use \maketitle.
  - Render the document title manually.
  - Use the defined accent colors when stylistically appropriate.
  - Preserve the specified page dimensions and margins.
